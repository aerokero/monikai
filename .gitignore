backend/data/
# Long-term memory snapshots
data/long_term_memory/
# User profile, personality, calendar, reminders, activity log
data/user_memory/
# Memory store index and pages
data/memory/
# Session history and conversation logs
data/sessions/
# Auto-generated daily recap files
data/recaps/
# Soul runtime state (inner_state, user_state, evolution, state.json)
data/soul/
