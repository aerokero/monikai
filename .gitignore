# MonikAI Specific - Runtime Data (User Generated, Should Not Be Committed)
# All data files are stored in /data/ directory
backend/data/                      # Any sync/cache copies of data in backend
data/long_term_memory/             # Long-term memory snapshots
data/user_memory/                  # User profile, personality, calendar, reminders, activity log
data/memory/                       # Full-text search index and pages
data/sessions/                     # Session history and conversation logs
data/recaps/                       # Auto-generated daily recap files
tmp/                               # Temporary files (pytest fixtures etc.)
data/kg/                          # Knowledge graph database
data/study/                        # Study materials and PDFs
data/study/Genki 1 - Study Book.pdf
data/settings.json                 # User-specific settings (contains local config)
data/reference.jpg                 # Reference image
data/spotify_tokens.json           # OAuth tokens (SECURITY: Never commit)
data/spotify_oauth_state.json      # OAuth state (SECURITY: Never commit)

